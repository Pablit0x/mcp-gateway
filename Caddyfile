{
	admin off
	auto_https off
}

:{$PORT:10000} {
	# Jeden publiczny /health (Render health check + cron-job.org). Nie odpytuje backendow:
	# start.sh konczy kontener, gdy ktorykolwiek proces padnie, wiec Render go zrestartuje.
	handle /health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# Intervals: /intervals/mcp -> 127.0.0.1:8001/mcp (prefiks obciety)
	handle_path /intervals/* {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	# Fitatu: /fitatu/mcp -> 127.0.0.1:8002/mcp (prefiks obciety)
	handle_path /fitatu/* {
		reverse_proxy 127.0.0.1:8002 {
			flush_interval -1
		}
	}

	# Reszta (w tym /mcp oraz endpointy OAuth Fitatu: /.well-known/*, /register, /authorize, /token, /oauth/confirm)
	# idzie do Fitatu. OAuth Fitatu jest zakotwiczone w katalogu glownym domeny, wiec te sciezki nie moga miec prefiksu.
	handle {
		reverse_proxy 127.0.0.1:8002 {
			flush_interval -1
		}
	}
}
